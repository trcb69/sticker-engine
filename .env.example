# Copy to .env and fill in. Never commit .env — it holds the x.gd API key.
# Node 20 reads this file directly via --env-file, so no dotenv dependency.

# ---- Server ----------------------------------------------------------------
STICKER_PORT=6969
# 127.0.0.1 keeps the service behind a reverse proxy. Use 0.0.0.0 only if the
# warehouse reaches it directly on the LAN with no proxy in front.
STICKER_HOST=127.0.0.1

# ---- Document reading ------------------------------------------------------
# Confirmed against the sample documents: 09/04/2026 is 4 September 2026.
# Getting this wrong puts incorrect expiry dates on printed drums.
STICKER_DATE_ORDER=MDY
# Leave blank if pdfinfo and pdftotext are on PATH.
STICKER_POPPLER_BIN=

# ---- Label content ---------------------------------------------------------
STICKER_DEFAULT_MANUFACTURER=Miscellaneous Supplier
STICKER_MANUFACTURER_PREFIX=MANUFACTURER -
# No batch format is enforced unless one is set here. The batch code appears on
# no document, so the system has no basis for judging it. Set a pattern only if
# your codes genuinely follow one shape.
# STICKER_BATCH_PATTERN=^[A-Z]{3}\d{6}$

# ---- Short links -----------------------------------------------------------
# The origin the printed QR points at. Set this and short links are minted and
# resolved by this service itself (GET /J/<code>) — no API key, no rate limit,
# and no third party that can disappear from under a label already on a drum.
#
# It MUST be the apex domain. The QR budget on a 4x1 label is 96 dots and the
# ceiling is 38 characters:
#
#   https://standard-holdings.lk/J/HFH7K2        37 chars  ECC M   fits
#   https://sticker.standard-holdings.lk/J/...   43 chars          REFUSED
#
# Leave it unset until DNS actually resolves. An unset value refuses to mint
# with a clear message, which is the correct failure: a label printed against a
# URL that is about to change is a drum nobody can trace.
# STICKER_SHORT_BASE=https://standard-holdings.lk

# x.gd is still available as a provider, used only if STICKER_SHORT_BASE is
# unset. A shorter domain would buy error correction Q instead of M.
# Request a key at https://x.gd/en/developer
STICKER_XGD_API_KEY=
# x.gd enables click tracking unless told otherwise. A scan on a factory floor
# is not something a third party needs a record of.
STICKER_XGD_ANALYTICS=false
# Must survive a redeploy. A label printed today has to resolve in five years.
STICKER_SHORTLINK_STORE=./data/shortlinks.json

# ---- Printers --------------------------------------------------------------
# How the ZPL reaches the printer.
#   webusb   the page opens the printer's USB endpoint itself. Nothing to
#            install on the workstation, and it does not care that this page is
#            served over HTTPS. On Windows the printer must first be rebound
#            from usbprint.sys to WinUSB (Zadig), which also removes it from the
#            Windows printer list — fine for a Zebra only this page prints to.
#   browser  the operator's own machine sends it via Zebra Browser Print.
#            Needs the helper application installed per workstation.
#   network  this server opens a socket to port 9100. Ethernet Zebras only,
#            and only where this server can route to the printer.
STICKER_PRINT_TRANSPORT=webusb
# name=host:port,dpi — semicolons between machines, dpi defaults to 203.
# STICKER_PRINTERS=wh1=192.168.1.50:9100,203;wh2=192.168.1.51:9100

# Append-only record of who printed which batch. Must outlive a redeploy: it
# gets consulted months later, and it is what the reprint check reads.
STICKER_AUDIT_LOG=./data/audit.jsonl

# ---- Interface -------------------------------------------------------------
# Above this many labels in one run, the confirmation dialog makes the operator
# type the number. Accidentally sending 400 labels is the failure it prevents.
STICKER_CONFIRM_THRESHOLD=50

# ---- Storage ---------------------------------------------------------------
STICKER_TMP=./data/uploads
STICKER_JOB_TTL=1800
