{
  "id": "label-100x25-v2",
  "designDpi": 203,
  "widthIn": 3.94089,
  "heightIn": 0.98522,
  "quietZoneMm": 1.5,
  "print": {
    "darkness": 10,
    "rate": 4,
    "mediaTracking": "gap"
  },
  "slots": [
    {
      "id": "logo",
      "type": "graphic",
      "x": 14,
      "y": 28,
      "w": 144,
      "h": 144,
      "data": {
        "bytesPerRow": 18,
        "hex": ""
      }
    },
    {
      "id": "qr",
      "type": "qr",
      "y": 18,
      "budget": 96,
      "anchor": "right",
      "rightMargin": 18,
      "bind": "{qrPayload}",
      "ecc": "M",
      "model": 2,
      "eccFrom": "qrEcc"
    },
    {
      "id": "header",
      "type": "join",
      "x": 166,
      "y": 18,
      "w": 510,
      "parts": [
        "{customer}",
        "{docNo}",
        "MANUFACTURER - {manufacturer}"
      ],
      "separator": " | ",
      "maxLines": 2,
      "lineGap": 24,
      "size": 22,
      "minSize": 14,
      "bold": true
    },
    {
      "id": "nameBg",
      "type": "box",
      "x": 166,
      "y": 67,
      "w": 510,
      "h": 48,
      "fill": true
    },
    {
      "id": "name",
      "type": "text",
      "y": 67,
      "bind": "{displayName}",
      "box": "nameBg",
      "padX": 9,
      "size": 38,
      "minSize": 18,
      "bold": true,
      "reverse": true,
      "vAlign": "center"
    },
    {
      "id": "qtyBg",
      "type": "box",
      "x": 166,
      "y": 119,
      "h": 40,
      "fill": true,
      "sizeTo": {
        "slot": "qty",
        "padX": 9
      }
    },
    {
      "id": "qty",
      "type": "text",
      "y": 119,
      "bind": "QTY :- {qtyText}",
      "box": "qtyBg",
      "padX": 9,
      "size": 22,
      "minSize": 16,
      "bold": true,
      "reverse": true,
      "vAlign": "center"
    },
    {
      "id": "mnf",
      "type": "text",
      "y": 119,
      "bind": "MNF :- {mnfDate}",
      "flow": {
        "after": "qtyBg",
        "gap": 6
      },
      "size": 18,
      "minSize": 14,
      "bold": true
    },
    {
      "id": "exp",
      "type": "text",
      "y": 141,
      "bind": "EXP  :- {expDate}",
      "flow": {
        "after": "qtyBg",
        "gap": 6
      },
      "size": 18,
      "minSize": 14,
      "bold": true
    },
    {
      "id": "batch",
      "type": "barcode",
      "y": 118,
      "bind": "{batchCode}",
      "symbology": "code128",
      "flow": {
        "after": [
          "mnf",
          "exp"
        ],
        "gap": 4
      },
      "expand": "width",
      "rightMargin": 16,
      "barHeight": 40,
      "ratio": 3,
      "hri": "below",
      "hriSize": 18,
      "hriGap": 2
    },
    {
      "id": "border",
      "type": "box",
      "x": 12,
      "y": 12,
      "w": 775,
      "h": 176,
      "thickness": 2
    }
  ]
}
