# The development instance. Committed on purpose: nothing here is a secret.
#
#   node --env-file=.env.dev --watch src/server.js
#
# Port 6970 on localhost only, so it can never collide with production (6969)
# or be reached from outside the VPS. No base path: it owns its origin, so the
# page is at http://127.0.0.1:6970/ without the Hub in front of it.
# Its data goes under ./data/dev, which git ignores.

STICKER_PORT=6970
STICKER_HOST=127.0.0.1
STICKER_BASE_PATH=
STICKER_DATE_ORDER=MDY
STICKER_DEFAULT_MANUFACTURER=Miscellaneous Supplier
STICKER_PRINT_TRANSPORT=webusb
STICKER_XGD_ANALYTICS=false
STICKER_SHORTLINK_STORE=./data/dev/shortlinks.json
STICKER_AUDIT_LOG=./data/dev/audit.jsonl
STICKER_TMP=./data/dev/uploads
STICKER_ARCHIVE_DIR=./data/dev/jobs
STICKER_CONFIRM_THRESHOLD=50
STICKER_JOB_TTL=1800
